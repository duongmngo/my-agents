# Environment Configuration for My Agents Backend

# =============================================================================
# BASIC SETTINGS
# =============================================================================
ENVIRONMENT=development
DEBUG=true

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/my_agents_db
POSTGRES_DB=my_agents_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =============================================================================
# JWT SETTINGS
# =============================================================================
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# REDIS SETTINGS
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# MINIO SETTINGS (File Storage)
# =============================================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=chat-files
MINIO_SECURE=false

# =============================================================================
# QDRANT SETTINGS (Vector Database)
# =============================================================================
# Qdrant is used for storing pre-built vectors (embeddings are generated by workspace providers)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=qdrant-admin-key-123
QDRANT_DEFAULT_COLLECTION=documents
QDRANT_VECTOR_SIZE=1536
QDRANT_DISTANCE_METRIC=Cosine

# =============================================================================
# SMTP SETTINGS (Optional - for email notifications)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# =============================================================================
# FRONTEND SETTINGS
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# NOTES
# =============================================================================
# 1. Embedding provider configuration (OpenAI, Cohere, HuggingFace, Local) is now managed
#    at the workspace level through the admin interface, not through environment variables.
#
# 2. Each workspace can have multiple embedding providers configured with their own
#    API keys, models, and settings.
#
# 3. Only one embedding provider can be active per workspace at a time.
#
# 4. Qdrant is used purely for vector storage - it does not generate embeddings.
