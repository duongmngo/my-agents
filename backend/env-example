# Environment Configuration Example
# Copy this file to .env and update the values

# Application
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/my_agents_db
POSTGRES_DB=my_agents_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Security (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-this-in-production-make-it-long-and-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:3001"]
ALLOWED_HOSTS=["*"]

# Redis
REDIS_URL=redis://localhost:6379

# MinIO/S3 File Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=chat-files
MINIO_SECURE=false

# File Upload Settings
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=[".pdf", ".txt", ".md", ".doc", ".docx", ".jpg", ".jpeg", ".png", ".gif"]

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Email (Optional - for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Development URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# QDRANT
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=qdrant-admin-key-123
QDRANT_DEFAULT_COLLECTION=documents
QDRANT_VECTOR_SIZE=1536
QDRANT_DISTANCE_METRIC=Cosine

# AI Models
OPENAI_API_KEY=your-openai-api-key-here

# Web Search (Tavily)
TAVILY_API_KEY=your-tavily-api-key-here
